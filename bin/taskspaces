#!/bin/bash
# taskspaces: send the focused window to a named task workspace, or finish a task.
# Needs Hyprland, jq, python3, flock and Omarchy's menu helpers at runtime.
set -euo pipefail

version=0.1.0

# Keep naming pure so it can be tested without a compositor.
name_value() {
  python3 -I - "$@" <<'PY'
import re, sys, unicodedata
mode, cls, title = sys.argv[1:]
labels = {'google-chrome': 'Chrome', 'libreoffice-calc': 'Calc',
          'libreoffice-writer': 'Writer', 'org.gnome.Nautilus': 'Files',
          'com.mitchellh.ghostty': 'Terminal', 'Alacritty': 'Terminal',
          'kitty': 'Terminal', 'code': 'VS Code'}
def clean(text):
    text = ''.join(c for c in text if c not in '"\\[]{}<>$`' and not unicodedata.category(c).startswith('C'))
    return ' '.join(text.split())

label = clean(labels.get(cls, cls.rsplit('.', 1)[-1].capitalize())) or 'App'
if mode == 'label':
    print(label)
    sys.exit()
text = title
if mode == 'suggest':
    text = re.sub(r' - (?:Google Chrome|Chromium|LibreOffice (?:Calc|Writer|Impress|Draw)|Omawrite|Visual Studio Code)$', '', text)
    text = re.sub(r'^\(\d+\)\s*', '', text)
    text = re.sub(r'^\*\s*', '', text)
    text = re.sub(r'https?://\S+|[\w.+-]+@[\w.-]+\.[\w-]+|[A-Za-z0-9_-]{20,}|\d{10,}', '', text)
if mode == 'suggest':
    text = next((s.strip() for s in re.split(r' (?:-|—|–|·|\|) ', text) if s.strip()), '')
    text = re.sub(r'\s+\(\d+\)$', '', text)
    text = text.lstrip()
    while text and not text[0].isalnum():
        text = text[1:]
    if cls.startswith('libreoffice-'):
        text = re.sub(r'\.[A-Za-z0-9]{1,8}$', '', text)
text = clean(text)
if mode == 'suggest' and (not text or re.fullmatch(r'New Tab|Untitled.*|Loading.*', text, re.I) or text.casefold() in {label.casefold(), clean(cls).casefold(), 'google chrome', 'chromium', 'libreoffice ' + label.casefold()}):
    text = label + ' task'
# Fallback app labels follow the same rules as names from titles or input.
text = clean(text)
if re.fullmatch(r'\d+', text):
    text = 'Task ' + text
limit = 35 if mode == 'suggest' else 40
if len(text) > limit:
    prefix = text[:limit - 1]
    if not text[limit - 1].isspace() and ' ' in prefix:
        prefix = prefix.rsplit(' ', 1)[0]
    text = prefix.rstrip() + '…'
print(text)
PY
}

suggest_name() { name_value suggest "$1" "$2"; }
lua_string() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}
notify() {
  if $dry; then printf 'Notification: %s\n' "$*"; else
    if command -v omarchy-notification-send >/dev/null; then
      omarchy-notification-send -g '󰌨' 'taskspaces' "$*" >/dev/null || true
    elif command -v notify-send >/dev/null; then
      notify-send 'taskspaces' "$*" || true
    else
      printf 'taskspaces: %s\n' "$*" >&2
    fi
  fi
}
require_commands() {
  local tool missing=()
  for tool in hyprctl jq python3 flock omarchy-menu-select omarchy-menu-input; do
    command -v "$tool" >/dev/null || missing+=("$tool")
  done
  if (( ${#missing[@]} > 0 )); then
    notify "Missing required command: ${missing[*]}"
    return 1
  fi
}
dispatch() {
  if $dry; then printf 'hyprctl dispatch %q\n' "$1"; else
    local result live missing_address=${2:-}
    if ! result=$(hyprctl dispatch "$1") || [[ $result != ok ]]; then
      # Finish tolerates a window disappearing between the refresh and dispatch.
      if [[ -n $missing_address ]] && live=$(hyprctl clients -j) &&
        jq -e --arg address "$missing_address" 'all(.[]; .address != $address)' <<< "$live" >/dev/null; then
        return 0
      fi
      printf 'Dispatcher failed: %s\n%s\n' "$1" "$result" >&2
      notify "Dispatch failed: ${result:-no reply from Hyprland}"
      return 1
    fi
  fi
}
move_window() {
  dispatch "hl.dsp.window.move({ window = $(lua_string "address:$1"), workspace = $(lua_string "$2"), follow = $3 })" "${4:-}"
}
prune() {
  local file record
  tasks='[]'
  shopt -s nullglob
  for file in "$state_dir"/*.json; do
    if record=$(jq -ce --argjson workspaces "$workspaces" '
      . as $task | select((.id | type) == "number" and .id > 0
        and (.source | type) == "number" and (.name | type) == "string")
      | select(any($workspaces[]; .id == $task.id and .name == $task.name))' "$file"); then
      [[ $(basename "$file") == "$(jq -r .id <<< "$record").json" ]] || continue
      tasks=$(jq -c --argjson task "$record" '. + [$task]' <<< "$tasks")
    elif $dry; then printf 'Would prune: %s\n' "$file"; else rm -- "$file"; fi
  done
}
dedupe() {
  local base=$1 name=$1 limit=${2:-0} suffix=2
  while jq -e --arg name "$name" 'any(.[]; .name == $name
    or (($name | test("^[0-9]+$")) and .id == ($name | tonumber)))' <<< "$workspaces" >/dev/null; do
    if (( limit > 0 )); then
      name="${base:0:limit - ${#suffix} - 1} $suffix"
    else name="$base $suffix"; fi
    suffix=$((suffix + 1))
  done
  printf '%s\n' "$name"
}
rename_task() {
  local source=$1 cls=$2 record=$3 name workspaces pending
  name=$(omarchy-menu-input 'Task name') || return 0
  [[ -n ${name//[[:space:]]/} ]] || return 0
  name=$(name_value sanitize "$cls" "$name")
  [[ -n $name ]] || return 0
  # Recheck the captured workspace after input; ignore its own name in dedupe.
  workspaces=$(hyprctl workspaces -j)
  jq -e --argjson id "$source" --arg name "$(jq -r .name <<< "$record")" \
    'any(.[]; .id == $id and .name == $name)' <<< "$workspaces" >/dev/null || return 0
  workspaces=$(jq -c --argjson id "$source" '[.[] | select(.id != $id)]' <<< "$workspaces")
  name=$(dedupe "$name")
  if ! $dry; then
    pending="$state_dir/$source.json.tmp"
    jq --arg name "$name" '.name = $name' "$state_dir/$source.json" > "$pending"
  fi
  if ! dispatch "hl.dsp.workspace.rename({ workspace = $(lua_string "$source"), name = $(lua_string "$name") })"; then
    if ! $dry; then rm -- "$pending"; fi
    return 1
  fi
  if ! $dry; then mv -- "$pending" "$state_dir/$source.json"; fi
  notify "Renamed task: $name"
}
first_free() {
  jq -r '[.[] | .id | select(. > 0)] as $used | first(range(1; ($used | length) + 2) | select(. as $id | $used | index($id) | not))' <<< "$workspaces"
}
make_workspace_task() {
  local source=$1 cls=$2 name workspaces pending
  name=$(omarchy-menu-input 'Task name') || return 0
  [[ -n ${name//[[:space:]]/} ]] || return 0
  name=$(name_value sanitize "$cls" "$name")
  [[ -n $name ]] || return 0
  # The existing lock covers the menu and this recheck of the captured workspace.
  workspaces=$(hyprctl workspaces -j)
  jq -e --argjson id "$source" \
    'any(.[]; .id == $id and .id > 0 and .name == ($id | tostring))' <<< "$workspaces" >/dev/null || return 0
  [[ ! -e $state_dir/$source.json ]] || return 0
  name=$(dedupe "$name")
  if ! $dry; then
    pending="$state_dir/$source.json.tmp"
    jq -n --argjson id "$source" --arg name "$name" --argjson created "$(date +%s)" \
      '{id:$id, name:$name, source:$id, source_name:($id | tostring), created:$created}' > "$pending"
  fi
  if ! dispatch "hl.dsp.workspace.rename({ workspace = $(lua_string "$source"), name = $(lua_string "$name") })"; then
    if ! $dry; then rm -- "$pending"; fi
    return 1
  fi
  if ! $dry; then mv -- "$pending" "$state_dir/$source.json"; fi
  notify "Task \"$name\" → workspace $source"
}
send_task() {
  local window address cls title source return_source source_name suggested selection target name row record candidate plain_workspaces plain_target=false
  if [[ -n $requested_address ]]; then
    window=$(hyprctl clients -j | jq -c --arg address "$requested_address" 'first(.[] | select(.address == $address and .mapped != false)) // {}')
  else window=$(hyprctl activewindow -j); fi
  address=$(jq -r '.address // empty' <<< "$window")
  if [[ ! $address =~ ^0x[0-9a-fA-F]+$ ]]; then notify 'No window focused'; return; fi
  cls=$(jq -r '.class // ""' <<< "$window")
  title=$(jq -r '.title // ""' <<< "$window")
  source=$(jq -er '.workspace.id | select(type == "number")' <<< "$window")
  workspaces=$(hyprctl workspaces -j)
  prune
  return_source=$source
  (( return_source > 0 )) || return_source=1
  source_name=$(jq -r --argjson id "$return_source" 'first(.[] | select(.id == $id)).name // ($id | tostring)' <<< "$workspaces")
  suggested=$(dedupe "$(suggest_name "$cls" "$title")" 35)
  local first="Start task \"$suggested\"" typed='Start task with my own name…' rename='Rename this task…'
  local adopt="Turn workspace $source into a task…" can_adopt=false
  local -a rows=("$(printf '󰐗\t%s\tname suggested from the window title' "$first")" "$(printf '󰏫\t%s' "$typed")")
  local -A task_rows=() plain_rows=()
  [[ $cls != google-chrome ]] || rows[0]+=' · whole window (all tabs)'
  local source_record
  source_record=$(jq -c --argjson source "$source" 'first(.[] | select(.id == $source)) // empty' <<< "$tasks")
  [[ -z $source_record ]] || rows+=("$(printf '󰏫\t%s' "$rename")")
  if [[ -z $source_record && ! -e $state_dir/$source.json ]] && jq -e --argjson id "$source" \
    'any(.[]; .id == $id and .id > 0 and .name == ($id | tostring))' <<< "$workspaces" >/dev/null; then
    can_adopt=true
    rows+=("$(printf '󰉗\t%s\twindows stay where they are' "$adopt")")
  fi
  while IFS= read -r record; do
    candidate=$(jq -r .id <<< "$record")
    task_rows[$candidate]=$(jq -r '"Send to: " + .name + "\tworkspace " + (.id | tostring)' <<< "$record")
    rows+=("$(printf '󰉒\t%s' "${task_rows[$candidate]}")")
  done < <(jq -c --argjson source "$source" 'sort_by(.id)[] | select(.id != $source)' <<< "$tasks")
  plain_workspaces=$(jq -c --argjson tasks "$tasks" --argjson source "$source" '
    [.[] | select(.id > 0 and .id != $source)
      | select(.id as $id | any($tasks[]; .id == $id) | not)] | sort_by(.id)' <<< "$workspaces")
  while IFS= read -r record; do
    candidate=$(jq -r .id <<< "$record")
    plain_rows[$candidate]=$(jq -r '"Move to: " + .name + "\tworkspace " + (.id | tostring)' <<< "$record")
    rows+=("$(printf '󰉒\t%s' "${plain_rows[$candidate]}")")
  done < <(jq -c '.[]' <<< "$plain_workspaces")
  if $dry; then selection=$first; else
    selection=$(omarchy-menu-select 'Task' "${rows[@]}" -- --width 600) || return 0
  fi
  row=${selection%%$'\t'*}
  if [[ $selection == "$rename" && -n $source_record ]]; then
    rename_task "$source" "$cls" "$source_record"
    return
  fi
  if [[ $row == "$adopt" ]] && $can_adopt; then
    make_workspace_task "$source" "$cls"
    return
  fi
  if [[ $row == "$first" || $row == "$typed" ]]; then
    name=$suggested
    if [[ $row == "$typed" ]]; then
      name=$(omarchy-menu-input 'Task name') || return 0
      [[ -n ${name//[[:space:]]/} ]] || return 0
      name=$(name_value sanitize "$cls" "$name")
      [[ -n $name ]] || return 0
    fi
    # A workspace may have appeared while the menu was open.
    workspaces=$(hyprctl workspaces -j)
    if [[ $row == "$first" ]]; then name=$(dedupe "$name" 35); else name=$(dedupe "$name"); fi
    target=$(first_free)
    printf 'Target workspace: %s; name: %s; source: %s; address: %s\n' "$target" "$name" "$source" "$address"
    move_window "$address" "$target" "$follow"
    dispatch "hl.dsp.workspace.rename({ workspace = $(lua_string "$target"), name = $(lua_string "$name") })"
    if ! $dry; then
      jq -n --argjson id "$target" --arg name "$name" --argjson source "$return_source" --arg source_name "$source_name" --argjson created "$(date +%s)" \
        '{id:$id, name:$name, source:$source, source_name:$source_name, created:$created}' > "$state_dir/$target.json"
    fi
  else
    # Match the whole returned row; never trust arbitrary menu text as Lua.
    target=''
    while IFS= read -r record; do
      candidate=$(jq -r .id <<< "$record")
      if [[ $selection == "${task_rows[$candidate]}" ]]; then
        target=$candidate
        name=$(jq -r .name <<< "$record")
        break
      fi
    done < <(jq -c --argjson source "$source" '.[] | select(.id != $source)' <<< "$tasks")
    if [[ -z $target ]]; then
      while IFS= read -r record; do
        candidate=$(jq -r .id <<< "$record")
        if [[ $selection == "${plain_rows[$candidate]}" ]]; then
          target=$candidate
          name=$(jq -r .name <<< "$record")
          plain_target=true
          break
        fi
      done < <(jq -c '.[]' <<< "$plain_workspaces")
    fi
    [[ -n $target ]] || return 0
    workspaces=$(hyprctl workspaces -j)
    jq -e --argjson id "$target" --arg name "$name" 'any(.[]; .id == $id and .name == $name)' <<< "$workspaces" >/dev/null || return 0
    move_window "$address" "$target" "$follow"
  fi
  if $plain_target; then notify "Moved to workspace $target"; else notify "Task \"$name\" → workspace $target"; fi
}
finish_destination() {
  if [[ $source == "$id" ]]; then printf '%s\n' "$id"; return; fi
  local source_name
  source_name=$(jq -r '.source_name // (.source | tostring)' <<< "$record")
  if (( source > 0 )) && jq -e --argjson source "$source" --arg name "$source_name" --argjson tasks "$tasks" '
    any(.[]; .id == $source and .name == $name)
    and (any($tasks[]; .id == $source) | not)' <<< "$workspaces" >/dev/null; then
    printf '%s\n' "$source"
  elif jq -e --argjson tasks "$tasks" '
    (any(.[]; .id == 1 and .name != "1") | not)
    and (any($tasks[]; .id == 1) | not)' <<< "$workspaces" >/dev/null; then
    printf '1\n'
  else
    # Even the fallback may belong to another task. Use a free workspace then.
    first_free
  fi
}
finish_success() {
  local target=${1:-}
  workspaces=$(hyprctl workspaces -j)
  if [[ $source == "$id" ]]; then
    # In-place tasks keep their windows and focus; restore the numbered label.
    if jq -e --argjson id "$id" 'any(.[]; .id == $id)' <<< "$workspaces" >/dev/null; then
      dispatch "hl.dsp.workspace.rename({ workspace = $(lua_string "$id"), name = $(lua_string "$id") })"
    fi
    if ! $dry; then rm -f -- "$state_dir/$id.json"; fi
    notify "Finished: $name"
    return
  fi
  if [[ -z $target ]]; then
    prune
    target=$(finish_destination)
  fi
  # Preserve the record if focusing the return workspace fails.
  dispatch "hl.dsp.focus({ workspace = $(lua_string "$target") })"
  if ! $dry; then rm -f -- "$state_dir/$id.json"; fi
  notify "Finished: $name"
}
finish_task() {
  local workspace id name source record destination wins count summary selection address live remaining extra now start changed previous
  workspace=$(hyprctl activeworkspace -j)
  id=$(jq -er '.id | select(type == "number")' <<< "$workspace")
  workspaces=$(hyprctl workspaces -j)
  prune
  record=$(jq -c --argjson id "$id" 'first(.[] | select(.id == $id)) // empty' <<< "$tasks")
  if [[ -z $record ]]; then notify "This workspace isn't a task"; return; fi
  name=$(jq -r .name <<< "$record")
  source=$(jq -r .source <<< "$record")
  destination=$(finish_destination)
  wins=$(hyprctl clients -j | jq -c --argjson id "$id" '[.[] | select(.workspace.id == $id and .mapped != false) | {address, class, title}]')
  count=$(jq length <<< "$wins")
  if (( count == 0 )); then finish_success; return; fi
  summary=$(python3 -I - "$wins" <<'PY'
import collections, json, sys, unicodedata
labels = {'google-chrome':'Chrome', 'libreoffice-calc':'Calc', 'libreoffice-writer':'Writer', 'org.gnome.Nautilus':'Files', 'com.mitchellh.ghostty':'Terminal', 'Alacritty':'Terminal', 'kitty':'Terminal', 'code':'VS Code'}
items = []
for w in json.loads(sys.argv[1]):
    cls = w['class'] or ''
    label = labels.get(cls, cls.rsplit('.', 1)[-1].capitalize() or 'App')
    label = ''.join(c for c in label if c not in '"\\[]{}<>$`' and not unicodedata.category(c).startswith('C')) or 'App'
    if cls.startswith('libreoffice-'):
        label += ' (' + (w['title'] or '').split(' - LibreOffice', 1)[0].lstrip('* ') + ')'
    items.append(' '.join(label.split()))
print(', '.join(k + (' ×' + str(v) if v > 1 else '') for k, v in collections.Counter(items).items()))
PY
  )
  local windows="$count windows"
  (( count != 1 )) || windows='1 window'
  local close_row="Close $windows and finish" keep_row="Keep $windows and finish"
  local keep_note="returns to workspace $destination · nothing is closed"
  [[ $source != "$id" ]] || keep_note="stays in workspace $id · nothing is closed"
  if $dry; then selection=$close_row; else
    selection=$(omarchy-menu-select "Finish \"$name\"?" "$(printf '󰖭\t%s\t%s' "$close_row" "$summary")" "$(printf '󰐃\t%s\t%s' "$keep_row" "$keep_note")" $'󰁍\tCancel' -- --width 600) || return 0
  fi
  selection=${selection%%$'\t'*}
  [[ $selection == "$keep_row" || $selection == "$close_row" ]] || return 0
  # The menu can stay open while windows close, open, or change workspace.
  wins=$(hyprctl clients -j | jq -c --argjson id "$id" '[.[] | select(.workspace.id == $id and .mapped != false) | {address, class, title}]')
  workspaces=$(hyprctl workspaces -j)
  prune
  destination=$(finish_destination)
  if [[ $selection == "$keep_row" ]]; then
    if [[ $source != "$id" ]]; then
      while IFS= read -r address; do move_window "$address" "$destination" false "$address"; done < <(jq -r '.[].address' <<< "$wins")
    fi
    finish_success "$destination"
  elif [[ $selection == "$close_row" ]]; then
    count=$(jq length <<< "$wins")
    while IFS= read -r address; do
      [[ $address =~ ^0x[0-9a-fA-F]+$ ]] || return 1
      dispatch "hl.dsp.window.close({ window = $(lua_string "address:$address") })" "$address"
    done < <(jq -r '.[].address' <<< "$wins")
    if $dry; then
      printf 'Would poll recorded addresses every 0.25s (30s cap; 10s stalled without extra dialogs).\n'
      if [[ $source == "$id" ]]; then
        printf 'Would retain task if any remain; otherwise restore workspace number, remove %s/%s.json and keep focus.\n' "$state_dir" "$id"
      else
        printf 'Would retain task if any remain; otherwise remove %s/%s.json and return.\n' "$state_dir" "$id"
      fi
      finish_success
      return
    fi
    start=$SECONDS; changed=$SECONDS; previous=$count
    while :; do
      live=$(hyprctl clients -j)
      remaining=$(jq -c --argjson wins "$wins" '[.[] | select(.address as $a | any($wins[]; .address == $a))]' <<< "$live")
      count=$(jq length <<< "$remaining")
      if (( count == 0 )); then finish_success; return; fi
      now=$SECONDS
      if (( count < previous )); then changed=$now; previous=$count; fi
      extra=$(jq --argjson id "$id" --argjson wins "$wins" '[.[] | select(.workspace.id == $id and .mapped != false) | select(.address as $a | any($wins[]; .address == $a) | not)] | length' <<< "$live")
      if (( now - start >= 30 || (now - changed >= 10 && extra == 0) )); then break; fi
      sleep 0.25
    done
    notify "Not finished: $(jq -r '[.[0:3][] | "\"" + ((.title // .class) | gsub("[\\r\\n\\t]"; " ")) + "\""] | join(", ")' <<< "$remaining") still open"
  fi
}
# Setup and browser windows need no task state, runtime directory or jq.
desktop_task() {
  command -v python3 >/dev/null || { notify 'This command needs python3; install it and try again.'; return 1; }
  # Preserve terminal input on fd 3 while Python reads its program from stdin.
  python3 -I - "${BASH_SOURCE[0]}" "$@" 3<&0 <<'PY'
import collections
import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import unicodedata

START = '-- >>> taskspaces (added by `taskspaces setup`; undo with `taskspaces setup --remove`) >>>'
END = '-- <<< taskspaces <<<'
MODS = {'SUPER': 64, 'CTRL': 4, 'ALT': 8, 'SHIFT': 1}
ORDER = ('SUPER', 'CTRL', 'SHIFT', 'ALT')
DESCRIPTIONS = {'send': 'Send window to task', 'silent': 'Send window to task (stay here)',
                'finish': 'Finish task', 'browser': 'New browser window here'}
COMMANDS = {'send': 'send', 'silent': 'send --silent', 'finish': 'finish', 'browser': 'browser'}
CANDIDATES = {'send': ('SUPER + SHIFT + N', 'SUPER + CTRL + N', 'SUPER + T'),
              'finish': ('SUPER + SHIFT + D', 'SUPER + CTRL + D', 'SUPER + E'),
              'browser': ('SUPER + CTRL + SHIFT + RETURN', 'SUPER + SHIFT + ALT + RETURN',
                          'SUPER + CTRL + SHIFT + B')}

class SetupError(Exception):
    pass


def clean(text, limit=100):
    text = str(text).replace('\n', ' ').replace('\r', ' ').replace('\t', ' ')
    text = ''.join(c for c in text if not unicodedata.category(c).startswith('C')
                   and c not in '"`\\')
    return ' '.join(text.split())[:limit]


def message(text):
    print('taskspaces: ' + text, file=sys.stderr)
    tool = shutil.which('omarchy-notification-send') or shutil.which('notify-send')
    if tool:
        args = [tool, 'taskspaces', text]
        if Path(tool).name == 'omarchy-notification-send':
            args[1:1] = ['-g', '󰌨']
        try:
            subprocess.run(args, capture_output=True, timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass


def default_browser():
    # Match omarchy-launch-browser: ask its resolver, then read the first Exec
    # command in ~/.local, ~/.nix-profile or /usr/share/applications. Never run
    # the desktop entry's arguments or an Omarchy launcher.
    browsers = {'chromium': ('Chromium', 'chromium'),
                'google-chrome-stable': ('Chrome', 'google-chrome'),
                'brave': ('Brave', 'BraveSoftware/Brave-Browser'),
                'brave-origin': ('Brave Origin', 'BraveSoftware/Brave-Origin'),
                'microsoft-edge-stable': ('Edge', 'microsoft-edge')}
    binary = ''
    desktop = ''
    try:
        result = subprocess.run(['omarchy-cmd-default-browser'], capture_output=True,
                                text=True, timeout=15, check=False)
        desktop = result.stdout.strip() if result.returncode == 0 else ''
        if desktop and '/' not in desktop and '\\' not in desktop:
            for folder in (Path.home() / '.local', Path.home() / '.nix-profile', Path('/usr')):
                file = folder / 'share/applications' / desktop
                try:
                    match = re.search(r'^Exec=([^ \n]+)', file.read_text(), re.M)
                except (OSError, UnicodeError):
                    continue
                if match:
                    binary = match[1]
                    break
    except (OSError, subprocess.TimeoutExpired):
        pass
    name = Path(binary).name if binary else desktop.removesuffix('.desktop') or 'your default browser'
    label, folder = browsers.get(name, (name, None))
    return binary, label, folder


def browser():
    binary, label, folder = default_browser()
    if folder is None:
        raise SetupError('New browser windows are not supported for ' + clean(label) + ' yet.')
    state_dir = Path(os.environ.get('TASKSPACES_BROWSER_STATE_DIR') or
                     str(Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / folder))
    profiles = []
    def profile_text(value):
        return ''.join(c for c in value if not unicodedata.category(c).startswith('C')) \
            if isinstance(value, str) else ''
    try:
        data = json.loads((state_dir / 'Local State').read_text())
        cache = data.get('profile', {}).get('info_cache', {})
        for directory, info in cache.items():
            if (not directory or directory in ('.', '..') or '/' in directory or '\\' in directory
                    or profile_text(directory) != directory or not isinstance(info, dict)
                    or info.get('is_omitted') is True):
                continue
            name = profile_text(info.get('name')) or directory
            name = name if len(name) <= 50 else name[:49] + '…'
            profiles.append((name, profile_text(info.get('user_name')), directory))
    except (OSError, ValueError, AttributeError, UnicodeError):
        pass
    if not profiles:
        raise SetupError('No browser profiles found.')
    profiles.sort()
    directory = profiles[0][2]
    if len(profiles) > 1:
        if not shutil.which('omarchy-menu-select'):
            raise SetupError('Choosing a browser profile needs omarchy-menu-select; install it and try again.')
        counts = collections.Counter((name, email) for name, email, _ in profiles)
        rows = {}
        for name, email, directory in profiles:
            detail = email or 'Local profile'
            if counts[name, email] > 1:
                detail += ' · ' + directory
            rows[name + '\t' + detail] = directory
        result = subprocess.run(['omarchy-menu-select', label + ' - new window here',
                                 *('󰀄\t' + row for row in rows), '--', '--width', '600'],
                                capture_output=True, text=True, check=False)
        directory = rows.get(result.stdout.rstrip('\n')) if result.returncode == 0 else None
        if directory is None:
            return
    if not shutil.which(binary):
        raise SetupError('Cannot find ' + label + '; check your default browser installation.')
    args = [binary, '--profile-directory=' + directory, '--new-window', 'about:blank']
    if shutil.which('uwsm-app'):
        args = ['uwsm-app', '--', *args]
    # Close the helper's pipes and terminal so it returns immediately, even
    # when this is the first browser process in the session.
    subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)


def run(*args):
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=15, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise SetupError('Cannot reach Hyprland; run setup from your desktop session.') from error
    if result.returncode:
        raise SetupError('Hyprland could not complete ' + args[1] + '; nothing was accepted.')
    return result.stdout


def parse_key(text):
    parts = [part.strip().upper() for part in text.split('+')]
    if len(parts) < 2 or len(set(parts)) != len(parts):
        raise ValueError('Include modifiers and one key, such as SUPER + SHIFT + D.')
    key = parts[-1]
    if any(part not in MODS for part in parts[:-1]):
        raise ValueError('Use SUPER, CTRL, ALT or SHIFT before the key.')
    if not re.fullmatch(r'[A-Z0-9]|F(?:[1-9]|[12][0-9]|3[0-5])|RETURN|SPACE|TAB|ESCAPE|'
                        r'LEFT|RIGHT|UP|DOWN|HOME|END|PAGE_UP|PAGE_DOWN|INSERT|DELETE|BACKSPACE', key):
        raise ValueError('Use a letter, number, function key or named navigation key.')
    return sum(MODS[part] for part in parts[:-1]), key


def key_text(key, compact=False):
    mask, name = key
    parts = [part for part in ORDER if mask & MODS[part]] + [name]
    return ('+' if compact else ' + ').join(part.title() if compact and len(part) > 1 else part
                                           for part in parts)


def binds():
    try:
        data = json.loads(run('hyprctl', 'binds', '-j'))
        if not isinstance(data, list) or any(not isinstance(b, dict)
                or type(b.get('modmask')) is not int or not isinstance(b.get('key'), str)
                or not isinstance(b.get('dispatcher'), str) or not isinstance(b.get('arg'), str)
                for b in data):
            raise ValueError('unexpected shortcut data')
        return data
    except (ValueError, TypeError) as error:
        raise SetupError('Cannot read live shortcuts; check Hyprland and try setup again.') from error


def bind_key(bind):
    return bind['modmask'], bind['key'].upper()


def lua_binds(text):
    # Literal o.bind keys, including calls spread over several lines. Never execute Lua.
    text = re.sub(r'--\[\[.*?\]\]', lambda m: re.sub(r'[^\n]', ' ', m[0]), text, flags=re.S)
    text = re.sub(r'(?m)^[ \t]*--[^\n]*', lambda m: ' ' * len(m[0]), text)
    pattern = r'\bo\.bind(?:_toggle)?\s*\(\s*([\'"])([^\'"\n]+)\1\s*,\s*([\'"])(.*?)\3\s*,\s*([^\n]+)'
    return list(re.finditer(pattern, text, re.S))


def installed_keys(text):
    aliases = set(re.findall(r'\b([A-Za-z_]\w*)\s*=\s*[^\n]*taskspaces', text))
    result = []
    for match in lua_binds(text):
        command = match[5]
        own = 'taskspaces' in command or any(re.search(r'\b' + re.escape(a) + r'\b', command)
                                                    for a in aliases)
        action = re.search(r'[\'" ](send(?:\s+--silent)?|finish|browser)\s*[\'"]', command)
        if own and action:
            result.append((match[2], action[1], text[:match.start()].count('\n') + 1))
    return result


def managed_span(text):
    lines = text.splitlines(keepends=True)
    starts = [i for i, line in enumerate(lines) if line.rstrip('\r\n') == START]
    ends = [i for i, line in enumerate(lines) if line.rstrip('\r\n') == END]
    if not starts and not ends:
        return None
    if len(starts) != 1 or len(ends) != 1 or starts[0] >= ends[0]:
        raise SetupError('The taskspaces block has damaged markers; check your bindings file first.')
    return sum(map(len, lines[:starts[0]])), sum(map(len, lines[:ends[0] + 1]))


def stock_keys():
    used = {}
    folder = Path(os.environ.get('TASKSPACES_STOCK_BINDINGS_DIR', '/usr/share/omarchy/default/hypr/bindings'))
    if not folder.is_dir():
        raise SetupError('Cannot read Omarchy default shortcuts; check your Omarchy installation and retry.')
    for file in sorted(folder.glob('*.lua')):
        for match in lua_binds(file.read_text()):
            try:
                used[parse_key(match[2])] = clean(match[4], 45) or 'Omarchy shortcut'
            except ValueError:
                continue
    return used


def menu(title, rows):
    result = subprocess.run(['omarchy-menu-select', title, *rows, '--', '--width', '600'],
                            capture_output=True, text=True, check=False)
    return result.stdout.rstrip('\n').split('\t')[0] if result.returncode == 0 else ''


def choose_key(wanted, action, selected, stock):
    def occupied():
        used = dict(stock)
        for bind in binds():
            used[bind_key(bind)] = clean(bind.get('description') or
                                        (bind['dispatcher'] + ' ' + bind['arg']), 45)
        used.update({key: 'another Taskspaces shortcut' for key in selected.values()})
        return used
    used = occupied()
    if wanted not in used:
        return wanted
    if not shutil.which('omarchy-menu-select'):
        message(key_text(wanted, True) + ' is already used; skipped. Taskspaces still works from the command line.')
        return None
    candidates = CANDIDATES.get(action, ())
    if action == 'silent':
        candidates = [key_text((key[0] | MODS['ALT'], key[1]))
                      for key in map(parse_key, CANDIDATES['send']) if not key[0] & MODS['ALT']]
    alternative = next((parse_key(key) for key in candidates if parse_key(key) not in used), None)
    title = key_text(wanted, True) + ' is already used by "' + used[wanted] + '"'
    rows = []
    label = 'Use ' + key_text(alternative, True) + ' instead' if alternative else ''
    if alternative:
        rows.append('󰐗\t' + label + '\tfree')
    rows += ['󰏫\tPick my own key…', '󰁍\tSkip this shortcut']
    selection = menu(title, rows)
    if label and selection == label:
        if alternative not in occupied():
            return alternative
        raise SetupError('That shortcut was just taken; run setup again to choose another.')
    if selection == 'Pick my own key…':
        if not shutil.which('omarchy-menu-input'):
            raise SetupError('Choosing a key needs omarchy-menu-input; install it and try again.')
        for _ in range(3):
            result = subprocess.run(['omarchy-menu-input', 'Shortcut, for example SUPER + SHIFT + D'],
                                    capture_output=True, text=True, check=False)
            if result.returncode or not result.stdout.strip():
                break
            try:
                key = parse_key(result.stdout.strip())
                if key in occupied():
                    raise ValueError(key_text(key, True) + ' is already used; choose a free shortcut.')
                return key
            except ValueError as error:
                message(str(error))
    message('Skipped ' + action + '. Taskspaces still works from the command line.')
    return None


def consent(selected, block, remove):
    keys = ', '.join(key_text(key, True) + ' ' + action for action, key in selected.items())
    title = 'Remove Taskspaces shortcuts?' if remove else 'Add Taskspaces shortcuts?'
    if shutil.which('omarchy-menu-select'):
        yes = 'Yes, remove them' if remove else 'Yes, add them'
        no = 'No, keep my shortcuts\tleave my bindings file unchanged' if remove else \
             "No, I'll add them myself\tthe README shows how"
        while True:
            choice = menu(title, ['󰐗\t' + yes + '\tyour bindings file is backed up first · ' + keys,
                                  '󰁮\tShow me the lines first\t' + keys,
                                  '󰁍\t' + no])
            if choice == 'Show me the lines first':
                print(block, end='', flush=True)
            else:
                return choice == yes
    if os.isatty(3):
        print(title + ' ' + keys, flush=True)
        print(block, end='', flush=True)
        with os.fdopen(os.dup(3)) as terminal:
            print('Back up your bindings first, then proceed? [y/N] ', end='', flush=True)
            return terminal.readline().strip().lower() in ('y', 'yes')
    raise SetupError('Setup needs the Omarchy menu or a terminal for consent; nothing changed.')


def offer_browser():
    key = 'Super+Alt+Return'
    if shutil.which('omarchy-menu-select'):
        label = 'Add a "new browser window here" shortcut'
        return menu('Browser windows can jump back to where the browser was first opened',
                    ['󰀄\t' + label + '\t' + key,
                     '󰁍\tNot now\tyou can run taskspaces browser any time']) == label
    if os.isatty(3):
        print('Add a new browser window here shortcut (' + key + ')? [y/N] ', end='', flush=True)
        with os.fdopen(os.dup(3)) as terminal:
            return terminal.readline().strip().lower() in ('y', 'yes')
    return False


def runs_browser(command):
    try:
        args = shlex.split(command)
        return any(Path(word).name == 'taskspaces' and args[i + 1] == 'browser'
                   for i, word in enumerate(args[:-1]))
    except ValueError:
        return False


def atomic_write(target, data, mode):
    pending = None
    try:
        with tempfile.NamedTemporaryFile(dir=target.parent, prefix='.taskspaces-', delete=False) as out:
            pending = Path(out.name)
            os.fchmod(out.fileno(), stat.S_IMODE(mode))
            out.write(data)
            out.flush()
            os.fsync(out.fileno())
        os.replace(pending, target)
    finally:
        if pending is not None:
            pending.unlink(missing_ok=True)


def config_errors():
    return collections.Counter(line.strip() for line in run('hyprctl', 'configerrors').splitlines()
                               if line.strip())


def is_helper(bind, helper, action):
    try:
        return bind['dispatcher'] == 'exec' and shlex.split(bind['arg']) == [str(helper), *action.split()]
    except ValueError:
        return False


def setup():
    remove, dry = sys.argv[3:] == ['--remove'], sys.argv[3:] == ['--dry-run']
    helper = Path(sys.argv[1]).resolve()
    bindings_file = Path(os.environ.get('TASKSPACES_BINDINGS_FILE') or
                         str(Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') /
                             'hypr/bindings.lua'))
    target = bindings_file.resolve()
    if not target.is_file():
        raise SetupError('Bindings file is missing: ' + clean(bindings_file) + '; create it before running setup.')
    with target.open('rb') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise SetupError('Another setup is open; finish it before trying again.') from error
        original = lock.read()
        text = original.decode('utf-8')
        span = managed_span(text)
        existing = installed_keys(text)
        supported = False
        if not remove:
            browser_keys = [(key, action, line) for key, action, line in existing if action == 'browser']
            if browser_keys:
                message('Already set up: ' + ', '.join(clean(key) + ' browser' for key, _, _ in browser_keys) + '.')
                return
            supported = default_browser()[2] is not None
            if (span or existing) and (not span or not supported):
                keys = ', '.join(clean(key) + ' ' + action for key, action, _ in existing)
                message('Already set up: ' + (keys or 'see the taskspaces block in your bindings file') + '.')
                return
        if remove and not span:
            if existing:
                message('Nothing to remove automatically; delete the hand-added taskspaces bindings on lines ' +
                        ', '.join(str(line) for _, _, line in existing) + ' and their helper variable yourself.')
            else:
                message('Nothing to remove.')
            return
        original_stat = os.fstat(lock.fileno())
        mode = original_stat.st_mode
        if not mode & 0o222 or not os.access(target, os.W_OK) or not os.access(target.parent, os.W_OK):
            raise SetupError('Bindings file is not writable: ' + clean(bindings_file) + '; make it writable and retry.')
        if not shutil.which('hyprctl'):
            raise SetupError('Cannot read live shortcuts: hyprctl is missing; run setup in your desktop session.')
        live = binds()
        if not remove:
            browser_keys = [key_text(bind_key(bind), True) for bind in live
                            if bind['dispatcher'] == 'exec' and runs_browser(bind['arg'])]
            if browser_keys:
                message('Already set up: ' + ', '.join(key + ' browser' for key in browser_keys) + '.')
                return
        selected = {}
        if remove:
            block = text[span[0]:span[1]]
            for raw_key, action, _ in installed_keys(block):
                try:
                    selected['silent' if action == 'send --silent' else action] = parse_key(raw_key)
                except ValueError:
                    raise SetupError('A managed shortcut was edited into an unreadable key; check its block first.') from None
            updated = (text[:span[0]] + text[span[1]:]).encode('utf-8')
        else:
            stock = stock_keys()
            for raw_key, _, _ in existing:
                try:
                    stock[parse_key(raw_key)] = 'existing Taskspaces shortcut'
                except ValueError:
                    continue
            for action in (() if span else ('send', 'silent', 'finish')):
                if action == 'silent':
                    if 'send' not in selected:
                        continue
                    send = selected['send']
                    wanted = (send[0] | MODS['ALT'], send[1])
                else:
                    wanted = parse_key('SUPER + ' + ('N' if action == 'send' else 'D'))
                key = choose_key(wanted, action, selected, stock)
                if key:
                    selected[action] = key
            if supported and offer_browser():
                key = choose_key(parse_key('SUPER + ALT + RETURN'), 'browser', selected, stock)
                if key:
                    selected['browser'] = key
            if not selected:
                message('No shortcuts selected. Taskspaces still works from the command line.')
                return
            lines = [] if span else [START, 'local taskspaces_bin = ' + json.dumps(shlex.quote(str(helper)), ensure_ascii=False)]
            for action, key in selected.items():
                lines.append('o.bind(' + json.dumps(key_text(key)) + ', ' + json.dumps(DESCRIPTIONS[action]) +
                             ', taskspaces_bin .. " ' + COMMANDS[action] + '")')
            if span:
                # Preserve the old bindings and surrounding bytes on upgrade;
                # only the newly chosen browser key needs consent and checking.
                old_block = text[span[0]:span[1]]
                marker = old_block.rfind(END)
                newline = '\r\n' if '\r\n' in old_block else '\n'
                block = old_block[:marker] + newline.join(lines) + newline + old_block[marker:]
                updated = (text[:span[0]] + block + text[span[1]:]).encode('utf-8')
            else:
                block = '\n'.join(lines + [END, ''])
                updated = original + (b'\n' if original and not original.endswith(b'\n') else b'') + block.encode('utf-8')
        if not consent(selected, block, remove):
            message('No changes made; your shortcuts are still in place.' if remove else
                    'No changes made; the README shows how to add shortcuts yourself.')
            return
        if dry:
            print(block, end='')
            return
        # Menus may stay open: do not overwrite edits or keys made meanwhile.
        if (bindings_file.resolve() != target or target.read_bytes() != original
                or target.stat().st_ino != original_stat.st_ino
                or target.stat().st_mode != mode):
            raise SetupError('Your bindings file changed while setup was open; run setup again.')
        live = binds()
        if not remove and any(bind_key(bind) in selected.values() for bind in live):
            raise SetupError('A selected shortcut was just taken; run setup again to choose another.')
        before_errors = config_errors()
        backup_dir = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'taskspaces/backups'
        backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
        backup = backup_dir / ('bindings.lua.' + stamp)
        with backup.open('xb') as out:
            os.fchmod(out.fileno(), stat.S_IMODE(mode))
            out.write(original)
            out.flush()
            os.fsync(out.fileno())
        atomic_write(target, updated, mode)
        try:
            if run('hyprctl', 'reload').strip() != 'ok':
                raise SetupError('Hyprland did not reload the shortcuts.')
            if config_errors() - before_errors:
                raise SetupError('Hyprland reported new configuration errors.')
            live = binds()
            if remove:
                for raw_key, action, _ in installed_keys(block):
                    key = parse_key(raw_key)
                    if any(bind_key(bind) == key and is_helper(bind, helper, action) for bind in live):
                        raise SetupError('Hyprland still shows a removed Taskspaces shortcut.')
            elif any(not any(bind_key(bind) == key and is_helper(bind, helper, COMMANDS[action])
                             for bind in live) for action, key in selected.items()):
                raise SetupError('Hyprland did not load every selected Taskspaces shortcut.')
        except SetupError as error:
            if bindings_file.resolve() != target or target.read_bytes() != updated:
                raise SetupError(str(error) + ' Your file changed again; restore the backup yourself: ' + str(backup)) from error
            try:
                atomic_write(target, backup.read_bytes(), mode)
            except OSError as restore_error:
                raise SetupError(str(error) + ' Restore the backup yourself: ' + str(backup)) from restore_error
            try:
                if run('hyprctl', 'reload').strip() != 'ok':
                    raise SetupError('reload failed')
            except SetupError:
                raise SetupError(str(error) + ' Your file was restored; reload Hyprland yourself. Backup: ' + str(backup)) from error
            raise SetupError(str(error) + ' Your bindings were restored and reloaded.') from error
        if remove:
            message('Taskspaces shortcuts removed. Backup: ' + str(backup))
        else:
            parts = []
            if 'send' in selected:
                parts.append(key_text(selected['send'], True) + ' sends a window to a task')
            if 'finish' in selected:
                parts.append(key_text(selected['finish'], True) + ' finishes it')
            if 'silent' in selected:
                parts.append(key_text(selected['silent'], True) + ' sends without following')
            if 'browser' in selected:
                parts.append(key_text(selected['browser'], True) + ' opens a new browser window here')
            message('Ready: ' + ', '.join(parts) + '.')

try:
    if sys.argv[2] == 'browser':
        browser()
    else:
        setup()
except (SetupError, OSError, UnicodeError) as error:
    message(clean(str(error), 500))
    sys.exit(1)
PY
}

usage() {
  printf '%s\n' \
    'Usage: taskspaces send [--silent] [--address 0x…] [--dry-run]' \
    '       taskspaces finish [--dry-run]' \
    '       taskspaces browser' \
    '       taskspaces setup [--remove | --dry-run]' \
    '       taskspaces --help | --version'
}
show_help() {
  usage
  printf '\n'
  printf '%s\n' \
    'send             Move the focused window to a task workspace. The menu suggests a name.' \
    'send --silent    Move the window without switching to its workspace.' \
    'send --address   Act on the window at this address instead of the focused one.' \
    'finish           Close or return the windows of the current task.' \
    'browser          Open a new browser window in the current workspace.' \
    'setup            Offer shortcuts and ask before changing your bindings.' \
    'setup --remove   Back up and remove only shortcuts added by setup.' \
    'setup --dry-run  Ask as usual, then print the block without writing or reloading.' \
    '--dry-run        Print the Hyprland commands instead of running them. Changes no state.' \
    '--version        Print the version.'
}
main() {
  local command='' requested_address='' dry=false follow=true workspaces tasks state_dir
  if [[ ${1:-} == browser ]]; then
    (( $# == 1 )) || { usage >&2; return 2; }
    desktop_task browser; return $?
  fi
  if [[ ${1:-} == setup ]]; then
    shift
    case $#:${1:-} in
      0:|1:--remove|1:--dry-run) desktop_task setup "$@"; return $? ;;
      *) usage >&2; return 2 ;;
    esac
  fi
  while (( $# )); do
    case $1 in
      send|finish) [[ -z $command ]] || return 2; command=$1 ;;
      --dry-run) dry=true ;;
      --silent) follow=false ;;
      --address) shift; requested_address=${1:?--address requires an address}; [[ $requested_address =~ ^0x[0-9a-fA-F]+$ ]] || return 2 ;;
      --help) show_help; return 0 ;;
      --version) printf '%s\n' "$version"; return 0 ;;
      *) usage >&2; return 2 ;;
    esac
    shift
  done
  [[ -n $command ]] || { printf 'Expected send or finish\n' >&2; return 2; }
  require_commands || return 1
  state_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/taskspaces
  # Dry runs create no state, lock file, menus, notifications, or dispatches.
  if ! $dry; then
    umask 077
    exec 9>"$XDG_RUNTIME_DIR/taskspaces.lock"
    flock -n 9 || return 0
    mkdir -p "$state_dir"
    chmod 700 "$state_dir"
  fi
  "${command}_task"
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
