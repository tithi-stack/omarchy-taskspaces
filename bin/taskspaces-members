#!/usr/bin/env python3
"""Task membership, paired-output operations and read-only bar labels.

CLI mutations use taskspaces' lock; labels can take it to retire dead records
without compositor writes. No config files or hot-plug listener are needed.
"""
import collections
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time


class TaskError(Exception):
    pass


class StuckTaskError(TaskError):
    def __str__(self):
        return (super().__str__() + '. This task is stuck. Press Super+D to forget it; '
                'your windows stay where they are.')


def lua(value):
    # JSON strings are Lua-compatible for these strings, except JSON's \u form.
    # Hide routing substrings from hyprctl; three digits also protect a/5.
    return json.dumps(str(value), ensure_ascii=False).replace('/', r'\047')


def positive(value):
    return type(value) is int and value > 0


def two_screen_enabled():
    # BarWidget.setting() reads overrides inline in shell.json layout entries.
    # Missing, null, malformed or non-boolean values keep this experiment off.
    config = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'omarchy/shell.json'
    try:
        data = json.loads(config.read_text())
        layout = data['bar']['layout']
        return data.get('version') == 1 and any(
            isinstance(entry, dict) and entry.get('id') == 'tithi-stack.taskspaces'
            and entry.get('experimentalTwoScreenTasks') is True
            for section in ('left', 'center', 'right') for entry in layout.get(section, []))
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return False


def first_task_workspace():
    # Read the same inline widget entry as two_screen_enabled(). Keep the
    # bounds in sync with firstTaskWorkspace in the widget settings schema.
    config = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'omarchy/shell.json'
    try:
        data = json.loads(config.read_text())
        layout = data['bar']['layout']
        if data.get('version') == 1:
            for section in ('left', 'center', 'right'):
                for entry in layout.get(section, []):
                    if isinstance(entry, dict) and entry.get('id') == 'tithi-stack.taskspaces':
                        value = entry.get('firstTaskWorkspace')
                        return value if type(value) is int and 1 <= value <= 50 else 6
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        pass
    return 6


def members(record, workspaces):
    if 'members' in record:
        result = record['members']
        if not isinstance(result, list) or not 1 <= len(result) <= 2:
            raise ValueError('invalid members')
    else:
        ws = next((w for w in workspaces if w['id'] == record['id']), {})
        result = [dict(id=record['id'], name=record['name'], output=ws.get('monitor', ''),
                       source=record['source'], source_name=record.get('source_name', str(record['source'])))]
    for item in result:
        if not (positive(item.get('id')) and isinstance(item.get('name'), str)
                and isinstance(item.get('output'), str) and positive(item.get('source'))
                and isinstance(item.get('source_name'), str)):
            raise ValueError('invalid member')
    if len({m['id'] for m in result}) != len(result) or result[0]['id'] != record['id']:
        raise ValueError('invalid primary')
    if len(result) == 2 and (len({m['name'] for m in result}) != 2
                             or len({m['output'] for m in result}) != 2):
        raise ValueError('duplicate member')
    return result


def records(folder, workspaces, dry=True, clients=None):
    result = []
    live_ids = {w['id'] for w in workspaces}
    window_ids = {w['workspace']['id'] for w in clients or []}
    window_ids.update(w['id'] for w in workspaces if w.get('windows', 0) > 0)
    for file in sorted(folder.glob('*.json')):
        protected = file.stem.isdigit() and int(file.stem) in window_ids
        try:
            item = json.loads(file.read_text())
            if not (positive(item.get('id')) and positive(item.get('source'))
                    and isinstance(item.get('name'), str) and file.name == str(item['id']) + '.json'):
                raise ValueError('invalid task')
            legacy = 'members' not in item
            item['members'] = members(item, workspaces)
            ids = {m['id'] for m in item['members']}
            protected = bool(ids & window_ids)
            # Existing blank workspaces remain tasks. Only a fully absent task
            # is dead; client data also protects against inconsistent getters.
            gone = clients is not None and not ids & live_ids
            stale_legacy = legacy and not any(w['id'] == item['id'] and w['name'] == item['name'] for w in workspaces)
            if (gone or stale_legacy) and not protected:
                if not dry:
                    # Keep names for lazy rule/name cleanup, outside *.json so
                    # a bar refresh immediately frees the task's reservations.
                    file.replace(file.with_suffix('.cleanup'))
                continue
            if stale_legacy:
                continue  # Preserve a window-bearing record without claiming a renamed workspace.
            result.append(item)
        except (ValueError, KeyError, TypeError, OSError):
            # A damaged modern record may contain reservations/recovery data.
            # Keep it for inspection rather than silently discarding that data.
            if not dry:
                try:
                    modern = 'members' in json.loads(file.read_text())
                except (ValueError, OSError):
                    modern = False
                if not modern and not protected:
                    file.unlink(missing_ok=True)
    return result


class Pair:
    def __init__(self, dry, folder):
        self.dry = dry
        self.folder = folder
        self.return_targets = {}

    def read(self, kind):
        return json.loads(subprocess.check_output(['hyprctl', kind, '-j'], text=True))

    def outputs(self):
        return [m for m in self.read('monitors') if not m.get('disabled') and m.get('mirrorOf') in (None, 'none')]

    def write(self, record):
        if self.dry:
            return
        file = self.folder / (str(record['id']) + '.json')
        pending = file.with_suffix('.json.tmp')
        pending.write_text(json.dumps(record, ensure_ascii=False) + '\n')
        pending.replace(file)

    def command(self, kind, code, vanished=None):
        if self.dry:
            print('hyprctl ' + kind + ' ' + code)
            return
        result = subprocess.run(['hyprctl', kind, code], capture_output=True, text=True)
        if result.returncode or result.stdout.strip() != 'ok':
            if vanished and not any(w['address'] == vanished for w in self.read('clients')):
                return
            raise TaskError('Hyprland ' + kind + ' failed: ' + (result.stdout or result.stderr).strip())

    def focus(self, wid=None, output=None):
        field, value = ('workspace', wid) if wid is not None else ('monitor', output)
        self.command('dispatch', 'hl.dsp.focus({ ' + field + ' = ' + lua(value) + ' })')

    def rename(self, member, name):
        self.command('dispatch', 'hl.dsp.workspace.rename({ workspace = ' + lua(member['id']) + ', name = ' + lua(name) + ' })')

    def snapshot(self, record):
        workspaces = self.read('workspaces')
        owned = {m['id']: m for m in record['members']}
        for ws in workspaces:
            if ws['id'] in owned and ws['name'] not in (
                    owned[ws['id']]['name'], str(ws['id']), record.get('pending_names', {}).get(str(ws['id']))):
                raise StuckTaskError('Workspace ' + str(ws['id']) + ' changed name')
        for other in records(self.folder, workspaces):
            if other['id'] != record['id'] and owned.keys() & {m['id'] for m in other['members']}:
                raise StuckTaskError('Task workspace ownership conflicts')
        return workspaces

    def reconcile(self, tasks, workspaces):
        """Release only owned orphan handles and repair dead generated names.

        A different live task's name is still a conflict. The narrow recovery
        exception is a generated name whose originating task record is absent.
        """
        if self.dry:
            return
        self.cleanup_dead(tasks)
        workspaces = self.read('workspaces')
        task_ids = {t['id'] for t in tasks}
        owners = {m['id']: t for t in tasks for m in t['members']}
        rules = self.read('workspacerules')
        stale = set()
        for rule in rules:
            old = re.fullmatch(r'taskspaces-(\d+)-[12]', rule.get('defaultName', ''))
            selector = rule.get('workspaceString', '')
            if old and rule.get('enabled') is not False and int(old[1]) not in task_ids and selector.isdigit():
                stale.add(int(selector))
        if any(r.get('enabled') is not False and r.get('persistent') and r.get('defaultName') for r in rules):
            live_table = ', '.join('[' + str(i) + '] = true' for i in sorted(owners))
            stale_table = ', '.join('[' + str(i) + '] = true' for i in sorted(stale))
            code = ('local live = { ' + live_table
                    + ' }; local stale = { ' + stale_table + ' }; '
                    + 'for key, r in pairs(_G.__taskspaces_rules or {}) do '
                    + 'local id = tonumber(key:match("^taskspaces:(%d+)$")); '
                    + 'if id and (not live[id] or stale[id]) then '
                    + 'r:set_enabled(false); _G.__taskspaces_rules[key] = nil end end')
            self.command('eval', code)
            for rule in self.read('workspacerules'):
                if rule.get('workspaceString', '').isdigit() and int(rule['workspaceString']) in stale and rule.get('enabled') is not False:
                    raise StuckTaskError('Orphan task rule has no releasable owned handle')
        repaired = set()
        for ws in workspaces:
            old = re.fullmatch(r'taskspaces-(\d+)-[12]', ws['name'])
            if not old or int(old[1]) in task_ids:
                continue
            owner = owners.get(ws['id'])
            if owner:
                owner.setdefault('pending_names', {})[str(ws['id'])] = ws['name']
                self.write(owner)
                repaired.add(owner['id'])
            else:
                # Keep every window; only remove the name of a dead task.
                self.rename(ws, str(ws['id']))
        for record in tasks:
            if record['id'] in repaired:
                self.readable_members(record, force=True)

    def cleanup_dead(self, tasks):
        """Finish metadata-only retirement through the existing rule release."""
        owned = {m['id'] for task in tasks for m in task['members']}
        for file in sorted(self.folder.glob('*.cleanup')):
            record = json.loads(file.read_text())
            if not (positive(record.get('id')) and positive(record.get('source'))
                    and isinstance(record.get('name'), str) and file.stem == str(record['id'])):
                raise TaskError('Dead task cleanup record is invalid')
            for member in members(record, self.read('workspaces')):
                if member['id'] in owned:
                    continue  # A new recorded task already owns this number.
                self.rule(member, release=True)
                names = {member['name'], record.get('pending_names', {}).get(str(member['id']))}
                if any(w['id'] == member['id'] and w['name'] in names for w in self.read('workspaces')):
                    self.rename(member, str(member['id']))
            file.unlink()

    def reserved_ids(self, tasks, workspaces, extra=()):
        reserved = {m['id'] for t in tasks for m in t['members']} | set(extra)
        reserved.update(w['workspace']['id'] for w in self.read('clients'))
        reserved.update(m['activeWorkspace']['id'] for m in self.outputs())
        reserved.update(int(r['workspaceString']) for r in self.read('workspacerules')
                        if r.get('enabled') is not False and r.get('workspaceString', '').isdigit())
        reserved.update(w['id'] for w in workspaces if w.get('ispersistent') or w['name'] != str(w['id']))
        return reserved

    def free_ids(self, tasks, workspaces, extra=(), base=None):
        """For paired creation, reuse only empty, inactive ordinary slots."""
        base = first_task_workspace() if base is None else base
        reserved = self.reserved_ids(tasks, workspaces, extra)
        return next(i for i in range(base, base + len(reserved) + 1) if i not in reserved)

    def workspace_names(self, record, workspaces):
        owned = {m['id'] for m in record['members']}
        used = {w['name'] for w in workspaces if w['id'] not in owned}
        for other in records(self.folder, workspaces):
            if other['id'] != record['id']:
                used.add(other['name'])
                used.update(m['name'] for m in other['members'])
        names = []
        candidate = record['name']
        for _ in record['members']:
            while candidate in used:
                candidate += ' ·'
            names.append(candidate)
            used.add(candidate)
        return names

    def readable_members(self, record, force=False):
        # Older builds exposed generated names to a shell still running the old
        # widget. Use readable native names too, keeping them distinct for Lua
        # name selectors. The record tracks authorized intermediate names.
        if not force and not any(m['name'] == f'taskspaces-{record["id"]}-{i}'
                                 for i, m in enumerate(record['members'], 1)):
            return
        workspaces = self.snapshot(record)
        names = self.workspace_names(record, workspaces)
        for member, name in zip(record['members'], names):
            old_name = member['name']
            ws = next((w for w in workspaces if w['id'] == member['id']), None)
            if old_name == name and (ws is None or ws['name'] == name):
                continue
            record.setdefault('pending_names', {})[str(member['id'])] = ws['name'] if ws else old_name
            member['name'] = name
            self.write(record)
            # Update an owned persistence handle as well, so recreation cannot
            # restore the old generated name after a successful migration.
            connected = {m['name'] for m in self.outputs()}
            migration_output = member['output'] if member['output'] in connected else (ws.get('monitor') if ws else None)
            self.rule(member, output=migration_output)
            current = next((w for w in self.read('workspaces') if w['id'] == member['id']), None)
            if current is not None:
                self.rename(member, name)
        if not self.dry:
            live = self.snapshot(record)
            for member in record['members']:
                ws = next((w for w in live if w['id'] == member['id']), None)
                if ws is not None and ws['name'] != member['name']:
                    raise StuckTaskError('Task name update could not be verified')
                record.get('pending_names', {}).pop(str(member['id']), None)
        self.write(record)

    def rule(self, member, release=False, output=None):
        # Never replace a pre-existing numeric workspace rule. Only handles in
        # this private Lua table can be updated/disabled; config reload expires
        # them. Bind creation to the requested output before refresh can create
        # an empty workspace on the currently focused/default monitor.
        rules = self.read('workspacerules')
        existing = any(r.get('workspaceString') == str(member['id']) and r.get('enabled') is not False for r in rules)
        key = lua('taskspaces:' + str(member['id']))
        code = '_G.__taskspaces_rules = _G.__taskspaces_rules or {}; local r = _G.__taskspaces_rules[' + key + ']; '
        spec = ('hl.workspace_rule({ workspace = ' + lua(member['id'])
                + ', persistent = true, monitor = ' + lua(output or member['output'])
                + ', default_name = ' + lua(member['name']) + ' })')
        register = '_G.__taskspaces_rules[' + key + '] = ' + spec
        if release:
            code += 'if r then r:set_enabled(false); _G.__taskspaces_rules[' + key + '] = nil end'
        else:
            # Re-register only OUR enabled handle; Hyprland merges its fields
            # into the same rule. This also repairs pre-binding build handles.
            code += 'if r and r:is_enabled() ~= nil then r:set_enabled(true); ' + register
            if not existing:
                code += '; else ' + register
            code += ' end'
        code += '; hl.exec_scheduled_prop_refresh_immediately()'
        self.command('eval', code)

    def ensure(self, record, member, output, visible=True):
        workspaces = self.snapshot(record)
        self.rule(member, output=output)
        workspaces = self.snapshot(record)
        # Observe the explicit refresh before
        # deciding that a lost empty member needs the focus-based fallback.
        for _ in range(5):
            if self.dry or any(w['id'] == member['id'] for w in workspaces):
                break
            time.sleep(0.05)
            workspaces = self.snapshot(record)
        ws = next((w for w in workspaces if w['id'] == member['id']), None)
        if ws is None and not self.dry:
            if not visible:
                raise TaskError('Empty workspace could not be restored silently; use Go to restore the task')
            record.setdefault('pending_names', {})[str(member['id'])] = str(member['id'])
            self.write(record)
            self.focus(output=output)
            self.focus(member['id'])
            # We created this ID after proving it absent; name only that ID.
            self.rename(member, member['name'])
        if ws is not None and ws['name'] != member['name']:
            self.rename(member, member['name'])
        if ws is None or ws.get('monitor') != output:
            if not visible:
                raise TaskError('Task area needs visible placement repair; use Go to restore the task')
            # The scout confirmed the targeted selector against Hyprland's
            # running source. Rule refresh fixes placement first; this is only
            # repair for an existing area, followed by an ownership check.
            self.command('dispatch', 'hl.dsp.workspace.move({ workspace = ' + lua(member['id']) + ', monitor = ' + lua(output) + ' })')
        if not self.dry:
            live = self.snapshot(record)
            if not any(w['id'] == member['id'] and w['name'] == member['name'] and w.get('monitor') == output for w in live):
                raise StuckTaskError('Workspace did not reach its recorded screen')
            record.get('pending_names', {}).pop(str(member['id']), None)
            self.write(record)

    def window(self, captured):
        addr = captured.get('address', '')
        if not re.fullmatch(r'0x[0-9a-fA-F]+', addr):
            raise StuckTaskError('Invalid window address')
        return next((w for w in self.read('clients') if w['address'] == addr and w.get('mapped') is not False), None)

    @staticmethod
    def same_window(before, after):
        return before['address'] == after['address'] and all(
            before.get(k) == after.get(k) for k in ('pid', 'class', 'initialClass', 'initialTitle', 'stableId') if k in before)

    def move(self, captured, target):
        before = self.window(captured)
        if before is None:
            return False
        if not self.same_window(captured, before) or before['workspace']['id'] != captured['workspace']['id']:
            raise StuckTaskError('Window changed before move')
        self.command('dispatch', 'hl.dsp.window.move({ window = ' + lua('address:' + before['address']) + ', workspace = ' + lua(target) + ', follow = false })', before['address'])
        if not self.dry:
            after = self.window(before)
            if after is not None and (not self.same_window(before, after) or after['workspace']['id'] != target):
                raise StuckTaskError('Window move could not be verified')
        return True

    @staticmethod
    def screen(window, monitors, workspaces):
        return next((m['name'] for m in monitors if m['id'] == window.get('monitor')), None) or next(
            (w.get('monitor') for w in workspaces if w['id'] == window.get('workspace', {}).get('id')), None) or next(
            (m['name'] for m in monitors if m.get('focused')), monitors[0]['name'])

    def go(self, record, preferred=None):
        self.readable_members(record)
        workspaces = self.snapshot(record)
        monitors = self.outputs()
        if not monitors or len(monitors) > 2:
            raise StuckTaskError('Task switching supports one or two connected screens')
        focus = preferred or next((m['name'] for m in monitors if m.get('focused')), monitors[0]['name'])
        if len(monitors) == 1:
            visible = next((m for m in record['members'] if m['output'] == monitors[0]['name']), record['members'][0])
            self.ensure(record, visible, monitors[0]['name'])
            owned = {m['id'] for m in record['members']}
            for win in self.read('clients'):
                original = win['workspace']['id']
                if original not in owned or original == visible['id'] or win.get('mapped') is False:
                    continue
                # Write recovery intent BEFORE the move. Retry handles both a
                # failed move (still original) and a successful unacknowledged one.
                entry = dict(address=win['address'], member=original, merged_into=visible['id'], window=win)
                recovery = record.setdefault('merged_windows', [])
                if not any(r['address'] == win['address'] for r in recovery):
                    recovery.append(entry)
                    self.write(record)
                self.move(win, visible['id'])
            self.focus(visible['id'])
        else:
            outputs = {m['name'] for m in monitors}
            if any(m['output'] not in outputs for m in record['members']):
                raise StuckTaskError('Recorded screen is unavailable')
            for member in record['members']:
                self.ensure(record, member, member['output'])
            for entry in list(record.get('merged_windows', [])):
                captured = entry['window']
                win = self.window(captured)
                if win and not self.same_window(captured, win):
                    # This address now identifies a changed/replaced window.
                    # Leave it alone and continue restoring the other windows.
                    win = None
                if win:
                    if win['workspace']['id'] == entry['merged_into']:
                        self.move(win, entry['member'])
                    elif win['workspace']['id'] != entry['member']:
                        # User moved it elsewhere. Forget provenance, never fetch it.
                        pass
                record['merged_windows'].remove(entry)
                self.write(record)
            for member in record['members']:
                self.focus(output=member['output'])
                self.focus(member['id'])
            last = next((m for m in record['members'] if m['output'] == focus), record['members'][0])
            self.focus(output=last['output'])
            self.focus(last['id'])
        record['used'] = int(time.time())
        self.write(record)

    def new(self, wid, name, source, source_name, window, follow, adopt):
        if not two_screen_enabled():
            raise TaskError('Experimental two-screen tasks are off; start the task again')
        monitors = self.outputs()
        if len(monitors) != 2:
            raise TaskError('Screens changed while the menu was open; try again')
        workspaces = self.read('workspaces')
        output = self.screen(window or {'workspace': {'id': source}}, monitors, workspaces)
        now = int(time.time())
        tasks = records(self.folder, workspaces)
        base = first_task_workspace()
        if not adopt and base >= 2:
            reserved = self.reserved_ids(tasks, workspaces)
            stop = base + 2 * len(reserved) + 4
            # Prefer blocks anchored to the configured base: 6-7, 8-9, ... .
            pair = next(((i, i + 1) for i in range(base, stop, 2)
                         if i not in reserved and i + 1 not in reserved), None)
            if pair is None:
                pair = next(((i, i + 1) for i in range(base, stop)
                             if i not in reserved and i + 1 not in reserved), None)
            if pair is None:
                wid = self.free_ids(tasks, workspaces, base=base)
                companion = self.free_ids(tasks, workspaces, [wid], base=base)
            else:
                wid, companion = pair
        else:
            # Base 1 preserves independent legacy slots. Adoption keeps the
            # explicit primary number, even when it is below the base.
            if not adopt:
                wid = self.free_ids(tasks, workspaces, base=base)
            companion = self.free_ids(tasks, workspaces, [wid], base=base)
        if adopt and not any(w['id'] == wid and w['name'] == str(wid) for w in workspaces):
            raise TaskError('Starting workspace changed; try again')
        print(f'Target workspace: {wid}; name: {name}; source: {source}; address: {window.get("address", "")}')
        primary = dict(id=wid, name=name, output=output, source=source, source_name=source_name)
        other = next(m for m in monitors if m['name'] != output)
        origin = other['activeWorkspace']
        secondary = dict(id=companion, name=name + ' ·', output=other['name'],
                         source=max(origin['id'], 1), source_name=origin['name'] if origin['id'] > 0 else '1')
        record = dict(id=wid, name=name, source=source, source_name=source_name,
                      created=now, used=now, members=[primary, secondary])
        for member, readable in zip(record['members'], self.workspace_names(record, workspaces)):
            member['name'] = readable
        # Persist ownership before any compositor change; partial creation stays
        # recoverable. Adoption explicitly authorizes only the starting workspace.
        reused = next((w for w in workspaces if w['id'] == wid), None)
        companion_reused = next((w for w in workspaces if w['id'] == companion), None)
        if adopt or reused is not None:
            record.setdefault('pending_names', {})[str(wid)] = str(wid)
        if companion_reused is not None:
            record.setdefault('pending_names', {})[str(companion)] = str(companion)
        self.write(record)
        if adopt or reused is not None:
            self.rename(primary, primary['name'])
        if companion_reused is not None:
            self.rename(secondary, secondary['name'])
        self.ensure(record, primary, output, visible=follow)
        self.ensure(record, secondary, other['name'], visible=follow)
        if follow:
            self.go(record, output)
        if window.get('address'):
            self.move(window, wid)
            if follow:
                self.focus(wid)
                if not self.dry and self.read('activeworkspace')['id'] != wid:
                    raise StuckTaskError('Started window could not be shown')

    def send(self, record, captured, follow):
        monitors = self.outputs()
        workspaces = self.read('workspaces')
        if follow:
            self.go(record, self.screen(captured, monitors, workspaces))
        workspaces = self.snapshot(record)
        if not monitors:
            raise TaskError('No connected screen')
        output = self.screen(captured, monitors, workspaces)
        target = next((m for m in record['members'] if m['output'] == output), record['members'][0])
        # Silent sends never activate/move whole workspaces. A lost empty target
        # is recreated using its rule, with its current output if already live.
        ws = next((w for w in workspaces if w['id'] == target['id']), None)
        if ws is None:
            self.rule(target)
        self.move(captured, target['id'])
        # A move creates a missing workspace with its numbered name.
        if ws is None:
            self.rename(target, target['name'])
        record['used'] = int(time.time())
        self.write(record)
        if follow:
            self.focus(target['id'])
            if not self.dry and self.read('activeworkspace')['id'] != target['id']:
                raise StuckTaskError('Sent window could not be shown')

    def task_windows(self, record):
        self.snapshot(record)
        ids = {m['id'] for m in record['members']}
        return [w for w in self.read('clients') if w.get('mapped') is not False and w['workspace']['id'] in ids]

    def forget(self, record):
        # Deliberately bypass snapshot/name/monitor checks: this is the escape
        # from those checks. Never focus, move or close a window or workspace.
        workspaces = self.read('workspaces')
        shared = {m['id'] for other in records(self.folder, workspaces)
                  if other['id'] != record['id'] for m in other['members']}
        for member in record['members']:
            if member['id'] in shared:
                continue  # Another recorded task still needs this name/rule.
            self.rule(member, release=True)
            if any(w['id'] == member['id'] for w in self.read('workspaces')):
                self.rename(member, str(member['id']))
        if not self.dry:
            (self.folder / (str(record['id']) + '.json')).unlink()
        print('Forgot task: ' + record['name'] + '. Your windows stay where they are.')

    def offer_forget(self, record, error):
        report_error(error)
        if self.dry:
            return False
        result = subprocess.run(['omarchy-menu-select', 'This task is stuck',
                                 '󰁍\tCancel',
                                 '󰁍\tForget this task\tyour windows stay where they are',
                                 '--', '--width', '600'], capture_output=True, text=True)
        if result.returncode == 0 and result.stdout.strip().split('\t')[0] == 'Forget this task':
            self.forget(record)
            return True
        return False

    def destination(self, member, record):
        workspaces = self.read('workspaces')
        reserved = {m['id'] for t in records(self.folder, workspaces) for m in t['members']}
        if member['source'] == member['id']:
            return member['id']
        outputs = self.outputs()
        output = member['output'] if any(m['name'] == member['output'] for m in outputs) else outputs[0]['name']
        cached = self.return_targets.get(member['id'])
        if cached and any(w['id'] == cached and w.get('monitor') == output for w in workspaces):
            return cached
        if member['source'] not in reserved and any(w['id'] == member['source'] and w['name'] == member['source_name'] and w.get('monitor') == output for w in workspaces):
            return member['source']
        # Reuse an empty numbered area on this output, never another screen's
        # workspace 1. Fresh fallback IDs also avoid configured numeric rules.
        occupied = {w['workspace']['id'] for w in self.read('clients')}
        candidates = sorted(w['id'] for w in workspaces if w['id'] > 0 and w['id'] not in reserved
                            and w['id'] not in occupied and w['name'] == str(w['id']) and w.get('monitor') == output)
        if candidates:
            self.return_targets[member['id']] = candidates[0]
            return candidates[0]
        used = reserved | {w['id'] for w in workspaces}
        used.update(int(r['workspaceString']) for r in self.read('workspacerules')
                    if r.get('enabled') is not False and r.get('workspaceString', '').isdigit())
        target = next(i for i in range(1, len(used) + 2) if i not in used)
        self.return_targets[member['id']] = target
        self.focus(output=output)
        self.focus(target)
        if not self.dry and not any(w['id'] == target and w.get('monitor') == output for w in self.read('workspaces')):
            raise StuckTaskError('Return workspace did not reach its screen')
        return target

    def finish(self, record):
        wins = self.task_windows(record)
        keep = False
        if wins:
            count = str(len(wins)) + (' window' if len(wins) == 1 else ' windows')
            close_row, keep_row = 'Close ' + count + ' and finish', 'Keep ' + count + ' and finish'
            labels = {'kitty': 'Terminal', 'ghostty': 'Terminal', 'google-chrome': 'Chrome', 'org.gnome.Nautilus': 'Files', 'com.mitchellh.ghostty': 'Terminal',
                      'Alacritty': 'Terminal', 'foot': 'Terminal', 'code': 'VS Code',
                      'libreoffice-calc': 'Calc', 'libreoffice-writer': 'Writer'}
            def app_label(win):
                import unicodedata
                value = labels.get(win['class'], win['class'].rsplit('.', 1)[-1].capitalize() or 'App')
                return ' '.join(''.join(c for c in value if c not in '"\\[]{}<>$`'
                                        and not unicodedata.category(c).startswith('C')).split()) or 'App'
            apps = collections.Counter(app_label(w) for w in wins)
            summary = ', '.join(k + (' ×' + str(v) if v > 1 else '') for k, v in apps.items())
            if self.dry:
                selection = close_row
            else:
                result = subprocess.run(['omarchy-menu-select', 'Finish "' + record['name'] + '"? (2 screens)',
                                         '󰖭\t' + close_row + '\t' + summary,
                                         '󰐃\t' + keep_row + '\treturns windows to their starting workspaces · nothing is closed',
                                         '󰁍\tCancel', '--', '--width', '600'], capture_output=True, text=True)
                if result.returncode:
                    return
                selection = result.stdout.strip().split('\t')[0]
            if selection not in (close_row, keep_row):
                return
            # Only the confirmation's reviewed addresses may be acted on. Newly
            # appeared windows/dialogs retain the task, including after polling.
            keep = selection == keep_row
            for captured in wins:
                win = self.window(captured)
                if not win or win['workspace']['id'] not in {m['id'] for m in record['members']}:
                    continue
                if not self.same_window(captured, win):
                    raise StuckTaskError('Window identity changed')
                if keep:
                    original = next((r['member'] for r in record.get('merged_windows', [])
                                     if r['address'] == win['address'] and self.same_window(r['window'], win)), win['workspace']['id'])
                    member = next(m for m in record['members'] if m['id'] == original)
                    self.move(win, self.destination(member, record))
                else:
                    self.command('dispatch', 'hl.dsp.window.close({ window = ' + lua('address:' + win['address']) + ' })', win['address'])
            if not keep and not self.dry:
                start = changed = time.monotonic()
                previous = len(wins)
                while True:
                    live = self.read('clients')
                    remaining = [w for w in live if any(self.same_window(c, w) for c in wins)]
                    if not remaining:
                        break
                    now = time.monotonic()
                    if len(remaining) < previous:
                        changed, previous = now, len(remaining)
                    extra = any(w['workspace']['id'] in {m['id'] for m in record['members']}
                                and not any(self.same_window(c, w) for c in wins) for w in live)
                    if now - start >= 30 or (now - changed >= 10 and not extra):
                        raise StuckTaskError('Not finished: reviewed windows still open')
                    time.sleep(0.25)
        if not self.dry:
            remaining = self.task_windows(record)
            # Adopted members legitimately keep their reviewed windows in place.
            if remaining and not (keep and all(any(self.same_window(c, w) for c in wins) and any(
                    m['source'] == m['id'] == w['workspace']['id'] for m in record['members']) for w in remaining)):
                raise StuckTaskError('Not finished: new or remaining windows')
        primary_dest = self.destination(record['members'][0], record)
        for member in record['members']:
            record.setdefault('pending_names', {})[str(member['id'])] = str(member['id'])
            self.write(record)
            self.rule(member, release=True)
            if any(w['id'] == member['id'] for w in self.read('workspaces')):
                self.rename(member, str(member['id']))
        self.focus(primary_dest)
        if not self.dry:
            (self.folder / (str(record['id']) + '.json')).unlink()
        print('Finished: ' + record['name'])


def main():
    dry, folder, action, *args = sys.argv[1:]
    pair = Pair(dry == 'true', Path(folder))
    if action == 'paired-enabled':
        sys.exit(0 if two_screen_enabled() else 1)
    elif action == 'first-workspace':
        print(first_task_workspace())
    elif action == 'records':
        workspaces = json.loads(args[0])
        tasks = records(pair.folder, workspaces, pair.dry, pair.read('clients'))
        if not pair.dry:
            pair.cleanup_dead(tasks)
        defer_reconcile = args[1:] == ['without-reconcile'] and any(len(t['members']) > 1 for t in tasks)
        if not defer_reconcile:
            pair.reconcile(tasks, workspaces)
        print(json.dumps(records(pair.folder, pair.read('workspaces'), True)))
    elif action == 'forget':
        requested = int(args[0]) if args and args[0] else pair.read('activeworkspace')['id']
        workspaces = pair.read('workspaces')
        # Read raw records so a changed name cannot prune away the task before
        # Forget sees it. Validate all fields used to construct compositor code.
        record = None
        for file in pair.folder.glob('*.json'):
            try:
                item = json.loads(file.read_text())
                if not (positive(item['id']) and positive(item['source']) and isinstance(item['name'], str)
                        and file.name == str(item['id']) + '.json'):
                    continue
                item['members'] = members(item, workspaces)
                if (args and args[0] and item['id'] == requested) or (
                        not (args and args[0]) and any(m['id'] == requested for m in item['members'])):
                    record = item
                    break
            except (OSError, ValueError, KeyError, TypeError):
                continue
        if record is None:
            raise TaskError('No task found here; use taskspaces forget --task-id ID for a task on another workspace')
        pair.forget(record)
    elif action == 'labels':
        result = {}
        if pair.folder.is_dir():
            # The bar passes true to prohibit compositor writes. Metadata-only
            # retirement is safe under the same nonblocking lock as the CLI.
            with (pair.folder.parent / 'taskspaces.lock').open('a') as lock:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    prune = True
                except BlockingIOError:
                    prune = False
                workspaces = pair.read('workspaces')
                for record in records(pair.folder, workspaces, not prune, pair.read('clients')):
                    for member in record['members']:
                        if any(w['id'] == member['id'] and w['name'] == member['name'] for w in workspaces):
                            result[str(member['id'])] = dict(name=record['name'], workspace_name=member['name'])
        print(json.dumps(result))
    elif action == 'new':
        wid, name, source, source_name, window, follow, adopt = args
        pair.new(int(wid), name, int(source), source_name, json.loads(window), follow == 'true', adopt == 'true')
    else:
        record = json.loads(args[0])
        # Reread authoritative metadata after the menu; never use stale recovery
        # provenance or names when another record was replaced while it was open.
        if not pair.dry:
            fresh = json.loads((pair.folder / (str(record['id']) + '.json')).read_text())
            fresh['members'] = members(fresh, pair.read('workspaces'))
            if fresh['members'] != record['members'] or fresh['name'] != record['name']:
                raise TaskError('Task changed while the menu was open; try again')
            record = fresh
        if action in ('go', 'finish'):
            try:
                pair.reconcile(records(pair.folder, pair.read('workspaces')), pair.read('workspaces'))
                if not pair.dry:
                    record = json.loads((pair.folder / (str(record['id']) + '.json')).read_text())
                    record['members'] = members(record, pair.read('workspaces'))
                if action == 'go':
                    pair.go(record)
                else:
                    pair.finish(record)
            except StuckTaskError as error:
                if not pair.offer_forget(record, error):
                    sys.exit(1)
        elif action == 'send':
            pair.send(record, json.loads(args[1]), args[2] == 'true')
        elif action == 'rename':
            pair.snapshot(record)
            record['name'] = args[1]
            pair.readable_members(record, force=True)
            pair.write(record)


def report_error(error):
    text = ' '.join(str(error).split())
    print('taskspaces: ' + text, file=sys.stderr)
    if sys.argv[1] != 'true':
        tool = shutil.which('omarchy-notification-send') or shutil.which('notify-send')
        if tool:
            subprocess.run([tool, 'taskspaces', text], capture_output=True, check=False)


if __name__ == '__main__':
    try:
        main()
    except (TaskError, OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        report_error(error)
        sys.exit(1)
